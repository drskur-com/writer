+/// What a scroll leaves over smaller than this is float error, not the edge.
+///
+/// The text's offset is an `f32` of up to millions of pixels, so moving it by
+/// a fraction of a pixel and reading back how far it moved can come out a
+/// hair short. Read as reaching the edge, that hair stretched the edge in the
+/// middle of the text, and the packets after it went into the stretch
+/// instead of the text: fine scrolling stuck there and sprang back.
+const UNUSED_TOLERANCE: f32 = 0.5;
+
+/// The part of `dy` that `used` left over, with float error dropped.
+fn unused(dy: f32, used: f32) -> f32 {
+    let rest = dy - used;
+    if rest.abs() < UNUSED_TOLERANCE { 0. } else { rest }
+}
