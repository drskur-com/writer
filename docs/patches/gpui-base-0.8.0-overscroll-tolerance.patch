+    #[test]
+    fn lifting_a_finger_in_the_middle_of_the_text_leaves_the_edge_alone() {
+        let start = Instant::now();
+        let mut overscroll = Overscroll::default();
+        let mut room = 10_000.;
+        overscroll.packet(-10., TouchPhase::Started, 400., start, text(&mut room));
+        let mut at = start;
+        for _ in 0..10 {
+            at += Duration::from_millis(8);
+            overscroll.packet(-40., TouchPhase::Moved, 400., at, text(&mut room));
+        }
+        overscroll.packet(0., TouchPhase::Ended, 400., at, text(&mut room));
+        overscroll.step(at + Duration::from_millis(16));
+        assert_eq!(overscroll.offset(), 0.);
+        // The next swipe scrolls the text right away.
+        let before = room;
+        let next = at + Duration::from_millis(100);
+        overscroll.packet(-2., TouchPhase::Started, 400., next, text(&mut room));
+        overscroll.packet(-2., TouchPhase::Moved, 400., next, text(&mut room));
+        assert_eq!(before - room, 4.);
+    }
+
+    #[test]
+    fn fine_scrolling_deep_in_the_text_never_stretches_the_edge() {
+        // The text is far from both ends; reading back how far an `f32`
+        // offset moved comes out a hair off for some packets.
+        let now = Instant::now();
+        let mut overscroll = Overscroll::default();
+        let start = -123_456.7_f32;
+        let offset = std::cell::Cell::new(start);
+        let scroll = |dy: f32| {
+            let before = offset.get();
+            offset.set(before + dy);
+            offset.get() - before
+        };
+        overscroll.packet(0., TouchPhase::Started, 400., now, scroll);
+        for ix in 0..200 {
+            let at = now + Duration::from_millis(8 * ix);
+            overscroll.packet(-0.37, TouchPhase::Moved, 400., at, scroll);
+            assert_eq!(overscroll.offset(), 0., "packet {ix} stretched the edge");
+        }
+        // The text itself moved, give or take the offset's own float error.
+        let moved = start - offset.get();
+        assert!((moved - 74.).abs() < 2., "moved {moved}");
+    }
