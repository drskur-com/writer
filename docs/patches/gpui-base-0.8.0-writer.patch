+    let (editor, window) = decoration_editor(cx, text, false);
+    let mut cx = VisualTestContext::from_window(window.into(), cx);
+    let clicks = std::rc::Rc::new(std::cell::RefCell::new(Vec::new()));
+    cx.update(|window, cx| {
